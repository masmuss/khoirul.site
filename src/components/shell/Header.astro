---
import { Icon } from "astro-icon/components";
import Search from "@/components/features/search/Search.astro";
import Logo from "@/components/shell/Logo.astro";
import MobileMenu from "@/components/shell/MobileMenu.astro";
import ThemeToggle from "@/components/shell/ThemeToggle.astro";
import { header } from "@/config/site";

const { textLinks, iconLinks } = header;
---

<header
	class="flex w-full flex-wrap p-8 text-sm sm:flex-nowrap sm:justify-start"
>
	<nav
		class="relative mx-auto flex w-full items-center justify-between gap-x-3 md:gap-5"
		aria-label="global"
	>
		<Logo loading="eager" fetchpriority="high" />

		<div class="ml-auto flex flex-row items-center md:gap-x-5">
			<!-- Desktop Navigation -->
			<div class="hidden lg:block">
				<nav aria-label="primary">
					<ul class="flex items-center gap-1">
						{
							textLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="inline-flex h-9 items-center justify-center rounded-md px-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
									>
										{link.text}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>

			<div class="hidden lg:block w-px h-4 bg-border"></div>

			<!-- Icons Navigation -->
			<div class="hidden items-center gap-x-4 lg:flex">
				{
					iconLinks.map((link) => (
						<a
							href={link.href}
							class="rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
							target={link.href.startsWith("http") ? "_blank" : "_self"}
							rel={link.href.startsWith("http") ? "noopener noreferrer" : ""}
							aria-label={link.text}
							title={link.text}
						>
							<Icon name={link.icon} class="h-5 w-5" />
						</a>
					))
				}
			</div>

			<div class="flex items-center gap-1 sm:gap-2 ml-1 sm:ml-2">
				<Search />
				<ThemeToggle />
				<MobileMenu
					navLinks={[
						...textLinks,
						...iconLinks.filter((link) => link.href.startsWith("/"))
					]}
				/>
			</div>
		</div>
	</nav>
</header>
